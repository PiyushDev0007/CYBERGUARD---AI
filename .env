# ============================================================
# CYBERGUARD X — Environment Configuration
# ============================================================

# Application
APP_NAME=CYBERGUARD X
APP_VERSION=3.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Security — IMPORTANT: change this in production!
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for development)
DATABASE_URL=sqlite:///./cyberguard.db

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Threat Intelligence (optional)
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLED=true
RDAP_ENABLED=true
DNS_ENABLED=true

# Limits
MAX_URL_LENGTH=4096
MAX_TEXT_LENGTH=50000
MAX_UPLOAD_SIZE_MB=10
MAX_REDIRECT_HOPS=10
MAX_PAGE_REQUESTS=80

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO

# Security
ALLOW_PRIVATE_NETWORKS=false
TRUST_PROXY_HEADERS=false
ENABLE_HSTS=false
